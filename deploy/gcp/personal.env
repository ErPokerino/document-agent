# One Google Cloud target for DocuFlow. Copy this file for another project
# (a company one, say) and change the values; the scripts read nothing else.
# No secrets here: passwords are generated into Secret Manager by provision.sh.

PROJECT_ID=tutoral-498710
REGION=europe-west1
# Document AI is regional by multi-region name, not by Cloud Run region.
DOCUMENT_AI_LOCATION=eu
BILLING_ACCOUNT=01774C-1B7F49-8FA302
# In the billing account's currency.
BUDGET_AMOUNT=100EUR

# The one account of the sign-in screen; its password is in Secret Manager.
LOGIN_USER=admin

PREFIX=docuflow
DATA_BUCKET=tutoral-498710-docuflow-data
MODELS_BUCKET=tutoral-498710-docuflow-models
SQL_INSTANCE=docuflow-pg
SQL_TIER=db-f1-micro
REPOSITORY=docuflow

# The language model served by llama.cpp, as files in MODELS_BUCKET.
LLM_MODEL_FILE=gemma-4-E4B-it-Q4_K_M.gguf
LLM_PROJECTOR_FILE=mmproj-gemma-4-E4B-it-BF16.gguf
LLM_MODEL_NAME=gemma-4-e4b-it
# The llama.cpp server image mirrored into Artifact Registry by build.sh.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
