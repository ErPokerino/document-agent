# One Google Cloud target for DocuFlow. Copy this file for another project
# (a company one, say) and change the values; the scripts read nothing else.
# No secrets here: passwords are generated into Secret Manager by provision.sh.

PROJECT_ID=tutoral-498710
REGION=europe-west1
# Document AI is regional by multi-region name, not by Cloud Run region.
DOCUMENT_AI_LOCATION=eu
BILLING_ACCOUNT=01774C-1B7F49-8FA302
# In the billing account's currency.
BUDGET_AMOUNT=100EUR

# The one account of the sign-in screen; its password is in Secret Manager.
LOGIN_USER=admin

PREFIX=docuflow
DATA_BUCKET=tutoral-498710-docuflow-data
MODELS_BUCKET=tutoral-498710-docuflow-models
SQL_INSTANCE=docuflow-pg
SQL_TIER=db-f1-micro
REPOSITORY=docuflow

# The open models the model server can load, one per line:
#   id | model file | projector file (vision; empty for text only) | parameters
# The id is what DocuFlow shows and records, the same as LM Studio's. Files
# are copied to MODELS_BUCKET by upload-models.sh. The server holds one model
# at a time and must fit the largest: LLM_MEMORY below.
LLM_MODELS="
gemma-4-e4b-it | gemma-4-E4B-it-Q4_K_M.gguf | mmproj-gemma-4-E4B-it-BF16.gguf | 7.5B
minicpm5-1b | MiniCPM5-1B-Q8_0.gguf | | 1B
minicpm5-2b | MiniCPM5-2B-Q4_K_M.gguf | | 2.6B
granite-4.2-3b | granite-4.2-3b-Q4_K_M.gguf | | 3B
spark-x2.5-4b | Spark-X2.5-4B-Q4_K_M.gguf | | 4.1B
qwen3-vl-4b | Qwen3-VL-4B-Instruct-Q4_K_M.gguf | mmproj-Qwen3-VL-4B-Instruct-F16.gguf | 4B
qwen3.6-35b-a3b | Qwen3.6-35B-A3B-Q4_K_M.gguf | mmproj-Qwen3.6-35B-A3B-BF16.gguf | 35B-A3B
"
# The largest model above is 20.6 GiB with its projector; 32Gi is the most a
# Cloud Run instance without a GPU can have.
LLM_CPU=8
LLM_MEMORY=32Gi
# The llama.cpp server image mirrored into Artifact Registry by build.sh.
LLAMA_CPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server
